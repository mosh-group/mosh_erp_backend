APP_NAME="MOSH ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Damascus
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="MOSH GROUP"
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MOSH_ALLOW_SETUP=true
MOSH_DEMO_DATA=false

# ZKTeco attendance integration (enable after migration/configuration)
ZKTECO_ENABLED=false
ZKTECO_BRIDGE_TOKEN=
ZKTECO_REQUIRE_EMPLOYEE_MAPPING=false
ZKTECO_PRIMARY_DEVICE_ID=zkteco-primary
ZKTECO_PRIMARY_DEVICE_NAME="Primary ZKTeco Terminal"
ZKTECO_PRIMARY_DEVICE_SERIAL=SFM1092440386
ZKTECO_PRIMARY_DEVICE_IP=192.168.1.20
