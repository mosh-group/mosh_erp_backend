      "required": [
        "name"
      ],
      "example": {
        "name": "شركة العميل",
        "type": "company",
        "active": true,
        "currency": "USD",
        "secondaryContacts": []
      },
      "behavior": "Normalized name is unique; optional emails must be valid; contact names are required for populated secondary-contact rows. Marketing profile writes require marketing permissions; finance master fields require accounting permission. Renames retain stable customer links. Marketing plans enforce draft/rejected → review → approved/rejected and manager-only decisions.",
      "source": "02,19,24,34,40,41",
      "mode": "array",
      "delete": true
    },
