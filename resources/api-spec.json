        "quoteFollowup",
        "salesFollowup",
        "followupNotes",
        "chatter",
        "invoiceCreated",
        "sentAt",
        "confirmedAt",
        "cancelledAt"
      ],
      "required": [
        "customer"
      ],
      "example": {
        "customer": "شركة العميل",
        "status": "draft",
        "lines": [
          {
            "type": "product",
            "product": "جلسة تصوير",
            "description": "تصوير",
            "qty": 1,
            "price": 100,
            "discount": 0,
            "tax": 0,
            "cost": 50
          }
        ],
        "optional": [],
        "notes": ""
      },
      "behavior": "Stages: draft/sent/order/cancel. Product rows require qty > 0, price/cost ≥ 0, discount/tax 0–100; section/note rows require description. Displayed quote totals are calculated from persisted product lines; invoice totals are independently recalculated on the server. Order confirmation is an authorized status operation; linked orders cannot be deleted while tasks/invoices exist. Optional rows require product, positive qty and nonnegative price. Chatter is stored with the quotation; all mutations also receive an independent authenticated server audit event.",
      "source": "02,19,24",
      "mode": "array",
      "delete": true
    },
