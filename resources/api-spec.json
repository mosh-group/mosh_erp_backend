        "contractTitle": "عقد خدمات",
        "customer": "شركة العميل",
        "status": "draft",
        "currency": "USD",
        "taxRate": 0,
        "lines": []
      },
      "behavior": "status: draft/active/expired/cancelled; endDate ≥ startDate; active contracts need at least one line. Each line has service, description, qty > 0 and price ≥ 0; taxRate 0–100; the existing renderer calculates displayed totals from stored lines.",
      "source": "02",
      "mode": "array",
      "delete": false
    },
    "quotations": {
      "model": "Quotation",
      "statePath": "quotations",
      "module": "sales",
      "fields": [
        "number",
        "title",
        "status",
        "customer",
        "customerId",
        "invoiceAddress",
        "deliveryAddress",
